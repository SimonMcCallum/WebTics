# WebTics Configuration
# Copy this file to .env and fill in production values
# NEVER commit .env to git!

# Environment
ENVIRONMENT=development  # development, production

# Database Configuration
POSTGRES_USER=webtics
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=webtics
DATABASE_URL=postgresql://webtics:CHANGE_ME_IN_PRODUCTION@db:5432/webtics

# API Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBTICS_API_KEY=GENERATE_WITH_secrets_token_urlsafe_32
SECRET_KEY=GENERATE_WITH_secrets_token_urlsafe_64

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Research Ethics (for withdrawal codes)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
WITHDRAWAL_SECRET_KEY=GENERATE_WITH_secrets_token_urlsafe_64

# --- Student teaching service (accounts, games, quotas, GA4 ingest) ---
# JWT signing secret for student/admin logins (falls back to SECRET_KEY if unset)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=GENERATE_WITH_secrets_token_urlsafe_64
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Public URL shown to students in snippets and used by the web SDK default
PUBLIC_BASE_URL=https://analytics.example.nz

# Direct/anonymous ingest via the legacy /api/v1/events + /sessions endpoints.
# MUST be false in production so all telemetry goes through the authenticated,
# quota-enforced /mp/collect path. Set true only for self-hosted/dev use.
ALLOW_ANON_INGEST=false

# Default per-game quotas (Modest tier). Admin can override per game.
WEBTICS_DEFAULT_RATE_PER_MIN=60
WEBTICS_DEFAULT_BURST=600
WEBTICS_DEFAULT_MAX_BYTES=104857600          # 100 MB
WEBTICS_DEFAULT_USER_MAX_BYTES=262144000     # 250 MB

# Branding (student-facing vs professional service)
WEBTICS_STUDENT_BRAND=Ludogogy Logging
WEBTICS_SERVICE_BRAND=WebTics

# --- Discord support bot (AI helper, local Ollama) ---
# Bot token from https://discord.com/developers/applications -> your app -> Bot
WEBTICS_DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN
# Ollama model to use (must be pulled: `ollama list`). gemma3:4b is a good fast default.
WEBTICS_OLLAMA_MODEL=gemma3:4b
# Optional: comma-separated course guild IDs (instant slash-command sync + scoping)
WEBTICS_DISCORD_GUILD_IDS=
# Set true to also answer @mentions (requires Message Content intent enabled on the bot)
WEBTICS_BOT_MENTION_REPLIES=false

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# Optional: Monitoring and Error Tracking
# SENTRY_DSN=
# PROMETHEUS_ENABLED=false

# Optional: Email notifications (for security alerts)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# ALERT_EMAIL=
